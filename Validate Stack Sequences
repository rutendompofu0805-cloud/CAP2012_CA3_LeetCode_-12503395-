https://leetcode.com/problems/validate-stack-sequences/submissions/2201296357

class Solution {
public:
    bool validateStackSequences(vector<int>& pushed, vector<int>& popped) {
        stack<int> st;
        int j = 0;

        for(int x : pushed){
            st.push(x);
            while (!st.empty() && st.top() == popped[j]){
                st.pop();
                j++;
            }
        }
        return st.empty();
        
    }
};
